# Elasticsearch
ELASTIC_VERSION=8.18.2
ELASTIC_PASSWORD=changeme
ES_JAVA_OPTS=-Xms1g -Xmx1g

# Kibana
KIBANA_VERSION=8.18.2
KIBANA_SYSTEM_PASSWORD=kibana_system_password
KIBANA_ELASTICSEARCH_USERNAME=kibana_system
KIBANA_ELASTICSEARCH_PASSWORD=kibana_system_password

# Relevance Studio connection (defaults point to local Elasticsearch)
ESRS_ELASTICSEARCH_URL=http://elasticsearch:9200
ESRS_ELASTICSEARCH_USERNAME=elastic
ESRS_ELASTICSEARCH_PASSWORD=changeme
CONTENT_ELASTICSEARCH_URL=http://elasticsearch:9200
CONTENT_ELASTICSEARCH_USERNAME=elastic
CONTENT_ELASTICSEARCH_PASSWORD=changeme

# Wikipedia loader
LOADER_ES_USER=elastic
LOADER_ES_PASSWORD=changeme
WIKI_INDEX_NAME=jawiki
WIKI_DOC_COUNT=200
WIKI_BATCH_SIZE=20

# Full dump loader
WIKI_DUMP_URL=https://dumps.wikimedia.org/jawiki/latest/jawiki-latest-pages-articles-multistream.xml.bz2
WIKI_DUMP_PATH=/data/dumps/jawiki-latest-pages-articles-multistream.xml.bz2
WIKI_FULL_INDEX_PREFIX=jawiki_full
WIKI_FULL_ALIAS_NAME=jawiki_full_current
# Fallback index used only when alias does not exist yet
WIKI_FULL_INDEX_NAME=jawiki_full
WIKI_FULL_BULK_SIZE=200
WIKI_MAX_DOC_CHARS=5000
